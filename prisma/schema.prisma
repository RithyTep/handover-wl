generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TicketData {
  ticketKey String   @id @map("ticket_key") @db.VarChar(50)
  status    String   @default("--") @db.VarChar(100)
  action    String   @default("--") @db.VarChar(100)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([updatedAt])
  @@map("ticket_data")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("app_settings")
}

model ScheduledComment {
  id           Int       @id @default(autoincrement())
  commentType  String    @default("jira") @map("comment_type") @db.VarChar(20)
  ticketKey    String?   @map("ticket_key") @db.VarChar(50)
  commentText  String    @map("comment_text") @db.Text
  cronSchedule String    @map("cron_schedule") @db.VarChar(100)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  lastPostedAt DateTime? @map("last_posted_at") @db.Timestamptz

  @@index([enabled])
  @@map("scheduled_comments")
}

model Backup {
  id                Int      @id @default(autoincrement())
  backupType        String   @default("auto") @map("backup_type") @db.VarChar(50)
  ticketData        Json?    @map("ticket_data") @db.JsonB
  appSettings       Json?    @map("app_settings") @db.JsonB
  scheduledComments Json?    @map("scheduled_comments") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  description       String?  @db.Text

  @@index([createdAt])
  @@map("backups")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique @db.VarChar(255)
  name          String?        @db.VarChar(255)
  picture       String?        @db.Text
  googleSub     String         @unique @map("google_sub") @db.VarChar(64)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy String?   @map("replaced_by") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Feedback {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(50)
  title       String   @db.Text
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  status      String   @default("new") @db.VarChar(50)

  @@map("feedback")
}
