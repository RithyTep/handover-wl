{"nodes": [{"id": "specs_2026_04_09_token_effective_claude_ecosystem_design_spec", "label": "Token-Effective Claude Ecosystem Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_04_09_token_effective_claude_ecosystem_design_claude_mem_indexing", "label": "claude-mem Codebase Indexing", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": "Component 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tree-sitter AST indexing into a persistent cross-session symbol database eliminates the re-explain-the-codebase tax: smart_search replaces reading 14 service files to find one method."}, {"id": "specs_2026_04_09_token_effective_claude_ecosystem_design_codemaps", "label": "Codemaps (Static Structural Snapshots)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": "Component 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three compact committed snapshot files replace reading 14 service files, 40+ route files, and 42 component files; deliberately manually maintained (not auto-generated) to stay simple and avoid a build-step dependency, with a same-commit update rule to prevent drift."}, {"id": "specs_2026_04_09_token_effective_claude_ecosystem_design_file_size_hook", "label": "PostToolUse File-Size Hook", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": "Component 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-blocking by explicit user choice (warnings only, Claude continues); bash script checks wc -l against per-path-pattern limits after every Write/Edit. Auto-running npm run build on Stop was rejected as too slow for a hook."}, {"id": "specs_2026_04_09_token_effective_claude_ecosystem_design_feature_command", "label": "/feature Scaffolding Command", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": "Component 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the 4-step manual /new-api flow with one command scaffolding a full vertical slice (schema + service + route + barrel export + codemap entries), enforcing conventions (thin routes, Zod validation, logger, apiSuccess helpers) from the start."}], "edges": [{"source": "specs_2026_04_09_token_effective_claude_ecosystem_design_spec", "target": "specs_2026_04_09_token_effective_claude_ecosystem_design_claude_mem_indexing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": "Component 1", "weight": 1.0}, {"source": "specs_2026_04_09_token_effective_claude_ecosystem_design_spec", "target": "specs_2026_04_09_token_effective_claude_ecosystem_design_codemaps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": "Component 2", "weight": 1.0}, {"source": "specs_2026_04_09_token_effective_claude_ecosystem_design_spec", "target": "specs_2026_04_09_token_effective_claude_ecosystem_design_file_size_hook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-09-token-effective-claude-ecosystem-design.md", "source_location": "Component 3", "weight": 1.0}, {"source": "specs_2026_04_09_token_effective_cla