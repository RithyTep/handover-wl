{"nodes": [{"id": "memories_refactoring_roadmap_refactoring_roadmap", "label": "Refactoring Roadmap", "file_type": "document", "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "memories_refactoring_roadmap_service_extraction", "label": "Phase 1: Extract Services from API Routes", "file_type": "rationale", "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": "## Phase 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 450-line ai-autofill route mixed AI logic, Jira calls, and prompt construction; extracting AIAutofillService, SlackMessagingService, and HandoverService shrinks routes to ~25-40 lines and restores the thin-route rule. Ranked highest priority for biggest impact."}, {"id": "memories_refactoring_roadmap_database_layer_consolidation", "label": "Phase 2: Consolidate Database Layer", "file_type": "rationale", "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": "## Phase 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two parallel DB access patterns coexist: legacy functional lib/services/database.ts (604 lines) and modern class-based server/repository. Rather than a breaking rewrite, database.ts becomes a ~100-line backward-compatible re-export layer delegating to TicketService/SettingsService."}, {"id": "memories_refactoring_roadmap_theme_separation", "label": "Phase 5: Theme Config Separation", "file_type": "rationale", "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": "## Phase 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single 1029-line theme-config.ts held all 7 themes; splitting into per-theme modules under lib/theme/themes/ with a THEME_CONFIGS map makes adding themes cheap and isolates maintenance."}], "edges": [{"source": "memories_refactoring_roadmap_refactoring_roadmap", "target": "memories_refactoring_roadmap_service_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": "## Phase 1", "weight": 1.0}, {"source": "memories_refactoring_roadmap_refactoring_roadmap", "target": "memories_refactoring_roadmap_database_layer_consolidation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": "## Phase 2", "weight": 1.0}, {"source": "memories_refactoring_roadmap_refactoring_roadmap", "target": "memories_refactoring_roadmap_theme_separation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": "## Phase 5", "weight": 1.0}, {"source": "memories_refactoring_roadmap_service_extraction", "target": "memories_clean_code_standards_architecture_pattern", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": null, "weight": 1.0}, {"source": "memories_refactoring_roadmap_database_layer_consolidation", "target": "memories_architecture_guide_repository_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".serena/memories/refactoring-roadmap.md", "source_location": "## Phase 2", "weight": 1.0}], "hyperedges": []}